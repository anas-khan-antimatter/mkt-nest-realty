{
  "schema": 1,
  "runsOn": "ubuntu-latest",
  "setup": [
    "npm ci || npm install"
  ],
  "build": [
    "npm run build --if-present"
  ],
  "services": [
    {
      "cmd": "npm start",
      "background": true
    }
  ],
  "run": [],
  "probes": [
    {
      "kind": "http",
      "url": "http://localhost:3000/health",
      "withinSec": 90
    }
  ],
  "secretEnv": [],
  "timeoutMinutes": 25
}
